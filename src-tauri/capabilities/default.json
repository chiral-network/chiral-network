{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main webview event subscription and confirmed window shutdown only; no shell, filesystem or remote-page permissions.",
  "windows": ["main"],
  "permissions": [
    "allow-consumer-command",
    "allow-inference-stream",
    "allow-inference-cancel",
    "allow-get-version-status",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy"
  ]
}
